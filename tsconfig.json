{
	"compilerOptions": {
	  // Enforce ESM (required for Vue 3)
	  "module": "ESNext", 
	  // Use modern Node.js ESM resolution
	  "moduleResolution": "NodeNext", // or "Node16" (matches Node.js ESM behavior)
	  // Base directory for relative imports (optional but helpful)
	  "baseUrl": ".", 
	  // Path aliases (use forward slashes!)
	  "paths": {
		"@/*": ["src/*"] // Maps "@/components/Hello" to "src/components/Hello"
	  },
	  // Ensure TypeScript emits ESM-compatible code
	  "target": "ESNext", 
	  "esModuleInterop": false, // Disable CommonJS interop (ESM-only)
	  "forceConsistentCasingInFileNames": true // Avoid Windows/macOS casing conflicts
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
  }